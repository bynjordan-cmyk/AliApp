# ---------------------------------------------------------------------------
# AliApp environment example. Copy to `.env.local` and fill in.
# Never commit real keys. Only EXPO_PUBLIC_* values are bundled into the app.
# ---------------------------------------------------------------------------

# Supabase project URL (local default shown).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key. Safe for the client: RLS is the security boundary.
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Storage bucket for private media (created by migration 0011).
EXPO_PUBLIC_SUPABASE_MEDIA_BUCKET=aliapp-media

# --- Database tests only (never shipped to the app) ---
# Connection string used by `npm run test:rls`.
ALIAPP_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/aliapp_test
