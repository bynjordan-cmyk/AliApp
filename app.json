{
  "expo": {
    "name": "AliApp",
    "slug": "aliapp",
    "version": "0.1.0",
    "scheme": "aliapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "locales": {},
    "extra": {
      "defaultLocale": "es"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aliapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AliApp usa la cámara para que puedas adjuntar fotos a lo que registras.",
        "NSPhotoLibraryUsageDescription": "AliApp accede a tus fotos para que puedas adjuntarlas a lo que registras."
      }
    },
    "android": {
      "package": "com.aliapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#FB6161",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6B6B",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
